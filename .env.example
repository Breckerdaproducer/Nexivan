PORT=5200
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexivan_logistics
DB_USER=postgres
DB_PASSWORD=your_password

# Authentication
JWT_SECRET=your_jwt_secret_key
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_admin_password
ADMIN_EMAIL=info@nexivanlogistics.com

# Email / SMTP Settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@nexivanlogistics.com
SMTP_PASS="your_smtp_password"
SMTP_FROM="Nexivan Logistics Support" <info@nexivanlogistics.com>
ADMIN_NOTIFY_EMAIL=admin@example.com

# Allowed CORS origins
CORS_ORIGIN=*
